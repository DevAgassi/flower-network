# Local development settings for compose.yaml and the apps.
# Copy to .env to override; every value has a default in compose.yaml.
# These are development credentials: never reuse them outside localhost.

POSTGRES_USER=flower
POSTGRES_PASSWORD=flower
POSTGRES_DB=flower
POSTGRES_PORT=5433

PGADMIN_PORT=5051

REDIS_PORT=6379

S3_ACCESS_KEY=flower
S3_SECRET_KEY=flower-secret
S3_BUCKET=flower-media
S3_PORT=9000
S3_CONSOLE_PORT=9001

PROMETHEUS_PORT=9090

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_PORT=3030

JAEGER_UI_PORT=16686
OTLP_HTTP_PORT=4318

# --- Apps (read by api / web in development; in production set real variables) ---
# DATABASE_URL=postgres://flower:flower@localhost:5433/flower
# REDIS_URL=redis://localhost:6379
# DATABASE_POOL_MAX=10
# API_URL=http://localhost:3001
# OUTBOX_RELAY=on
# LOG_LEVEL=info
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# METRICS_PORT=9464
