{
  "name": "@flower/api-client",
  "version": "0.0.0",
  "private": true,
  "description": "Typed HTTP client for the Flower Network API, generated from apps/api/openapi.json",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate": "openapi-typescript ../../apps/api/openapi.json --output src/schema.ts"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "@flower/typescript-config": "workspace:*",
    "openapi-typescript": "7.13.0",
    "typescript": "^6.0.3"
  }
}
