{
  "name": "@flower/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Types and contracts shared between apps",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@flower/typescript-config": "workspace:*",
    "typescript": "^6.0.2"
  }
}
